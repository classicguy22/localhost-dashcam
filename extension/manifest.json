{
  "manifest_version": 3,
  "name": "Localhost Dashcam",
  "description": "Save the last minute of a broken local web session.",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Localhost Dashcam",
    "default_icon": "icon.png"
  },
  "icons": { "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "probe.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "recorder.js"
      ],
      "run_at": "document_start"
    }
  ]
}
